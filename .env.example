# ---------------------------------------------------------------------------
# GrammaX environment configuration
#
# Copy this file to `.env` and fill in real values to enable cloud sync:
#
#     cp .env.example .env
#
# THE APP RUNS WITHOUT A `.env` FILE AT ALL. With no credentials it stays in
# local-only mode: progress, theme, packs and scores persist to localStorage on
# this device, and the header shows "Đang lưu cục bộ". Nothing breaks.
#
# Every value below is a deliberate placeholder. src/player/supabaseConfig.js
# recognises them and keeps the app in local-only mode, so copying this file
# verbatim cannot accidentally point the app at a nonexistent project.
#
# These are build-time variables. Vite inlines VITE_* values into the client
# bundle at build time, so changing one requires a rebuild and a redeploy.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcd1234def0.supabase.co
# Found in Supabase dashboard > Project Settings > Data API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable key (the newer `sb_publishable_...` format), e.g.
# sb_publishable_D8pZ2xQ4vN7mKcJrTsYuWg
# Found in Supabase dashboard > Project Settings > API Keys > Publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=your-placeholder-publishable-key

# ---------------------------------------------------------------------------
# OPTIONAL / DEPRECATED
# ---------------------------------------------------------------------------
# Legacy anon key. Still read as a fallback when the publishable key above is
# absent (see src/player/supabaseClient.js). New projects should use the
# publishable key instead; this alias can be removed once no deployment relies
# on it.
# VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# Only VITE_* names reach the browser. Never put the `service_role` secret key,
# a database password, or any third-party API token in this file or in `.env` —
# they would be compiled into the public JavaScript bundle. Server-side secrets
# belong in Edge Function / hosting environment variables, not here.
#
# `.env` is git-ignored; this file is committed and must never hold real values.
